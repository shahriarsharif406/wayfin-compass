  "components": {
    "schemas": {
      "CompensationIn": {
        "properties": {
          "distance_km": {
            "type": "number",
            "maximum": 20000.0,
            "exclusiveMinimum": 0.0,
            "title": "Distance Km"
          },
          "arrival_delay_minutes": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Arrival Delay Minutes"
          },
          "cancelled": {
            "type": "boolean",
            "title": "Cancelled",
            "default": false
          },
          "cancellation_notice_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 365.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancellation Notice Days"
          },
          "covered_route": {
            "type": "boolean",
            "title": "Covered Route",
            "description": "Customer says the flight left an EU/UK airport, or arrived in the EU/UK on an EU/UK airline"
          },
          "intra_eu": {
            "type": "boolean",
            "title": "Intra Eu",
            "default": false
          },
          "reason": {
            "$ref": "#/components/schemas/DelayReason",
            "default": "none_given"
          }
        },
        "type": "object",
        "required": [
          "distance_km",
          "arrival_delay_minutes",
          "covered_route"
        ],
        "title": "CompensationIn"
      },
      "CompensationOut": {
        "properties": {
          "verdict": {
            "type": "string",
            "title": "Verdict"
          },
          "indicative_amount_eur": {
            "type": "number",
            "title": "Indicative Amount Eur"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "indicative_amount_eur",
          "reasons",
          "disclaimer"
        ],
        "title": "CompensationOut"
      },
      "DelayReason": {
        "type": "string",
        "enum": [
          "none_given",
          "weather",
          "air_traffic_control",
          "external_strike",
          "security_risk",
          "technical_fault",
          "crew_issue",
          "other"
        ],
        "title": "DelayReason"
      },
      "DisputeIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "dispute_type": {
            "$ref": "#/components/schemas/DisputeType"
          },
          "merchant": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Merchant"
          },
          "amount": {
            "type": "number",
            "exclusiveMaximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "description": "ISO code, e.g. USD"
          },
          "statement_within_60_days": {
            "type": "boolean",
            "title": "Statement Within 60 Days",
            "default": true
          },
          "card_last4": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Card Last4"
          },
          "urgent": {
            "type": "boolean",
            "title": "Urgent",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "dispute_type",
          "merchant",
          "amount",
          "currency"
        ],
        "title": "DisputeIn"
      },
      "DisputeOut": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "priority": {
            "type": "string",
            "title": "Priority"
          },
          "expected_resolution_days": {
            "type": "integer",
            "title": "Expected Resolution Days"
          },
          "provisional_credit_eligible": {
            "type": "boolean",
            "title": "Provisional Credit Eligible"
          },
          "evidence_checklist": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Checklist"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "confirmation_email": {
            "additionalProperties": true,
            "type": "object",
            "title": "Confirmation Email"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "status",
          "priority",
          "expected_resolution_days",
          "provisional_credit_eligible",
          "evidence_checklist",
          "message",
          "confirmation_email"
        ],
        "title": "DisputeOut"
      },
      "DisputeType": {
        "type": "string",
        "enum": [
          "unauthorized",
          "duplicate",
          "not_received",
          "not_as_described",
          "wrong_amount",
          "cancelled_subscription"
        ],
        "title": "DisputeType"
      },
      "FeedbackIn": {
        "properties": {
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "resolved_without_human": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved Without Human"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "rating"
        ],
        "title": "FeedbackIn"
      },
      "FlightClaimIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "issue": {
            "$ref": "#/components/schemas/FlightIssue"
          },
          "airline": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Airline"
          },
          "flight_number": {
            "type": "string",
            "maxLength": 12,
            "minLength": 1,
            "title": "Flight Number"
          },
          "flight_date": {
            "type": "string",
            "title": "Flight Date",
            "description": "YYYY-MM-DD"
          },
          "expenses_amount": {
            "type": "number",
            "exclusiveMaximum": 1000000.0,
            "minimum": 0.0,
            "title": "Expenses Amount",
            "description": "USD"
          },
          "delay_hours": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 240.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Delay Hours"
          },
          "urgent": {
            "type": "boolean",
            "title": "Urgent",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "issue",
          "airline",
          "flight_number",
          "flight_date",
          "expenses_amount"
        ],
        "title": "FlightClaimIn"
      },
      "FlightClaimOut": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "priority": {
            "type": "string",
            "title": "Priority"
          },
          "claim_deadline_days": {
            "type": "integer",
            "title": "Claim Deadline Days"
          },
          "documents_needed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Documents Needed"
          },
          "max_cover_usd": {
            "type": "number",
            "title": "Max Cover Usd"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "confirmation_email": {
            "additionalProperties": true,
            "type": "object",
            "title": "Confirmation Email"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "status",
          "priority",
          "claim_deadline_days",
          "documents_needed",
          "max_cover_usd",
          "message",
          "confirmation_email"
        ],
        "title": "FlightClaimOut"
      },
      "FlightIssue": {
        "type": "string",
        "enum": [
          "delay",
          "cancellation",
          "baggage"
        ],
        "title": "FlightIssue"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandoffIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "issue_type": {
            "type": "string",
            "maxLength": 60,
